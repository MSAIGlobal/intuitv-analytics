# IntuiTV Analytics - Environment Variables
NEXT_PUBLIC_API_URL=https://api.intuitv.app
NEXT_PUBLIC_WS_URL=wss://api.intuitv.app/ws
NEXT_PUBLIC_FRONTEND_NAME=intuitv-analytics
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_REFRESH_INTERVAL=10000

# ── MOTHER Sentinel — crash reporting (static export app) ───────────────────
# Statically exported (no server runtime): render crashes are reported from the
# browser to a PUBLIC collector — a sibling app's POST /api/sentinel/report,
# which holds the ingest token server-side. The token is NEVER in this static
# bundle. Unset = inert (no crash reports sent).
NEXT_PUBLIC_SENTINEL_REPORT_URL=
